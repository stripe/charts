{
  "name": "@stripe/charts",
  "license": "MIT",
  "version": "0.0.1",
  "sideEffects": [
    "./dist/browser.js",
    "./dist/stripe-charts.min.js"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/html": "10.6.2",
    "@storybook/html-vite": "10.6.2",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prismjs": "^1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "10.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "8.3.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:all": "npm run clean && npm run build && npm run decl && npm run build:browser && npm run theming:check",
    "build:browser": "node scripts/build-browser.js && node scripts/check-bundle.js",
    "clean": "node -e \"for (const d of ['dist', 'storybook-static']) require('fs').rmSync(d, {recursive: true, force: true})\"",
    "decl": "tsc --project tsconfig.build.json",
    "test": "jest",
    "jest": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "npm run build:all && storybook dev --port 6107 --host 127.0.0.1 --no-open --ci",
    "storybook:build": "npm run build:all && storybook build --output-dir storybook-static --quiet",
    "storybook:serve": "vite preview --outDir storybook-static --port 6108 --host 127.0.0.1 --strictPort",
    "theming:check": "node scripts/theming-table.js",
    "types": "tsc --noEmit",
    "types:stories": "tsc --project tsconfig.stories.json",
    "prepack": "npm run build:all",
    "preview:build": "node scripts/build-preview.js"
  },
  "files": [
    "dist",
    "docs/reference.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./browser": "./dist/stripe-charts.min.js",
    "./schema.json": "./dist/stripe-charts.schema.json",
    "./package.json": "./package.json"
  },
  "description": "Declarative time-series charts and KPI cards.",
  "repository": {
    "type": "git",
    "url": "https://github.com/stripe/charts.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
